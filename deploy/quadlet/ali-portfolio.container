[Unit]
Description=Ahmad Ali Masykur Portfolio
Wants=network-online.target
After=network-online.target

[Container]
Image=registry.madalimasykur.my.id/madalimasykur/ali-portfolio:latest
ContainerName=ali-portfolio
# Replace this placeholder with the absolute path to the external environment file.
EnvironmentFile=/path/to/ali-portfolio.env
PublishPort=3500:3000
Pull=missing
AutoUpdate=registry
HealthCmd=node -e "fetch('http://127.0.0.1:3000').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
HealthInterval=30s
HealthTimeout=3s
HealthStartPeriod=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
